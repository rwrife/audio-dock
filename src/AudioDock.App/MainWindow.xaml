<Window x:Class="AudioDock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio Dock"
        Width="640"
        Height="360"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="32">
    <StackPanel VerticalAlignment="Center">
      <TextBlock FontSize="28" FontWeight="SemiBold" Text="Audio Dock" />
      <TextBlock Margin="0,12,0,0"
                 TextWrapping="Wrap"
                 Text="Read-only inventory is available through AudioDock.Diagnostics. Scene editing and audio mutation are not implemented in this UI." />
    </StackPanel>
  </Grid>
</Window>
